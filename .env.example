# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database -------------------------------------------------------------
POSTGRES_DB=coupleos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_PORT=5432

# The role the application connects as. Never `postgres` — a superuser
# connection bypasses every row-level security policy (ADR 0005).
APP_DB_USER=app_user
APP_DB_PASSWORD=dev_app

# --- Mail (ADR 0007 magic links) ------------------------------------------
MAILDEV_UI_PORT=1080
MAILDEV_SMTP_PORT=1025

# --- API ------------------------------------------------------------------
API_PORT=8080

# --- LLM (ADR 0003 abstraction, ADR 0011 provider selection) --------------
# Development runs on a local Ollama on the host.
#
# Both roles point at ONE model deliberately. On 8 GB of VRAM a second resident
# model forces eviction and reload between roles, and the fast role runs once
# per block — see ADR 0011. Split only if measurement justifies it.
#
# num_ctx MUST be set explicitly. Ollama's default is far below what these
# models support and exceeding it truncates SILENTLY, dropping blocks with no
# error anywhere.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_FAST_MODEL=qwen3.5:4b
LLM_DEEP_MODEL=qwen3.5:4b
LLM_NUM_CTX=4096

# --- Ollama hosted service (ADR 0013) -------------------------------------
# Empty means local. Sustained inference on a laptop GPU makes the whole
# machine unusable — the desktop compositor shares the card — so the hosted
# service exists to move it off-box without giving up ADR 0011's abstraction
# or SPEC.md 40's privacy stance: its stated policy is that prompts and
# responses are never logged or trained on. Every free tier reached through an
# aggregator reserves the opposite, which is why they are not options here.
#
# To switch, set both of these and pick a model the free tier allows:
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_API_KEY=<from https://ollama.com/settings/keys>
#   LLM_FAST_MODEL=gemma4:31b
#   LLM_DEEP_MODEL=gemma4:31b
#
# Measured 2026-08-12 against the free tier. `/api/tags` lists 18 models but
# only 7 are entitled — the list is not the entitlement, and the other 11
# return 403 "requires a subscription". Of the 7, only some pass
# data/ollama-toolcall-smoke.json:
#
#   gemma4:31b            PASS  1.2s   <- selected
#   nemotron-3-nano:30b   PASS  2.1s
#   minimax-m3            PASS  5.7s
#   gpt-oss:120b          FAIL  7.7s   1 of 3 calls
#   gpt-oss:20b           FAIL 13.4s   1 of 3 calls
#
# The two gpt-oss failures matter more than their size suggests: they returned
# one tool call and silently dropped the rest. ADR 0004 makes the tool layer the
# sole write path, so a dropped call writes nothing and the change report looks
# complete. Never adopt a model here without running the smoke test first.
OLLAMA_API_KEY=

# Thinking must be off for extraction. Measured: it produced 571 of 673 tokens
# and made the same call 4.6x slower (ADR 0011).
LLM_THINK=false

# OLLAMA_KEEP_ALIVE was here and did nothing: Ollama reads it as a *server*
# variable, the provider never sent it per-request, and Ollama is not in the
# compose stack for it to be passed to. Set it on the Ollama service itself if
# you run locally and want the model resident.

# Switch to Anthropic for the validation run by setting LLM_PROVIDER=anthropic
# and filling this in. Until then V0's product verdict stays explicitly open —
# a weak model's failure says nothing about whether the idea works (ADR 0011).
ANTHROPIC_API_KEY=
