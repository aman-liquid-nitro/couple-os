@using CoupleOS.Api.Pages
@model ProcessResult

@await Html.PartialAsync("_Version", Model.Save.File.Version)

@*
    The line beside the Save button describes the file, not the run, so a Process
    that wrote the file updates it out of band. Leaving it saying "saved ·
    version 2" next to a file that is now version 3 would be a small lie in the
    one place a user checks to see whether their words are safe.
*@
<div id="save-state" class="muted" hx-swap-oob="true">
    @if (Model.Save.Accepted)
    {
        <span>saved · version @Model.Save.File.Version</span>
    }
</div>

@if (!Model.Save.Accepted)
{
    @await Html.PartialAsync("_SaveConflict", Model.Save.File)
}
else if (Model.Report is { } report)
{
    @await Html.PartialAsync("_ChangeReport", report)
}
