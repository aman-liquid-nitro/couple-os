<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Couple OS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav><a class="brand" asp-page="/Index">Couple OS</a></nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    @* Served locally, not from a CDN. SPEC.md 40 makes privacy architectural,
       and a page rendering a couple's private data should not announce itself
       to a third party on every load. *@
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
