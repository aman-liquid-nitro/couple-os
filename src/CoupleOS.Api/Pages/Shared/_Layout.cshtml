<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Couple OS</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav>
            <a class="brand" asp-page="/Index">Couple OS</a>
            <span class="spacer"></span>
            @* Read from the request's own resolved session, never from a claim in
               the page. A signed-out visitor never reaches a page that renders
               this, but the check costs nothing and the alternative is a null. *@
            @if (CurrentSession.IsSignedIn)
            {
                @if (CurrentSession.HasCouple)
                {
                    @* Both surfaces reachable from every screen, and named for the
                       scope rather than for the mechanism: "Private" is what the
                       user is choosing, "chat thread" is how it happens to work.
                       ADR 0009 makes the choice of surface the thing that decides
                       visibility, so it has to be the thing on the label. *@
                    <a class="session" asp-page="/Captured">Captured</a>
                    <a class="session" asp-page="/Private">Private</a>
                    <a class="session" asp-page="/Couple/Invite">Partner</a>
                }
                <a class="session" asp-page="/SignOut">Sign out</a>
            }
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    @* Served locally, not from a CDN. SPEC.md 40 makes privacy architectural,
       and a page rendering a couple's private data should not announce itself
       to a third party on every load. *@
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
