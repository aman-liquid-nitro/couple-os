@page
@model SignInModel
@{ ViewData["Title"] = "Sign in"; }

<h1>Sign in</h1>

@if (Model.LinkSent)
{
    <p><strong>Check your email.</strong></p>
    <p class="muted">
        If there is an account for that address, a sign-in link is on its way — and
        if there is not, one has been created and the link will sign you in. Either
        way it works once and expires in @Model.LifetimeDescription.
    </p>
    <p class="muted">Nothing else is needed. We will never ask you for a password or a code.</p>
    <p><a asp-page="/SignIn">Use a different address</a></p>
}
else
{
    <p class="muted">
        We will email you a link. There is no password to remember, and none to lose.
    </p>

    @if (Model.RateLimited)
    {
        <p class="warning" role="alert">
            Too many links requested. Wait a few minutes and try again — the last
            link we sent you is probably still valid.
        </p>
    }

    @if (Model.InvalidAddress)
    {
        <p class="warning" role="alert">That does not look like an email address.</p>
    }

    <form method="post">
        <label for="Email">Email address</label>
        <input type="email" id="Email" name="Email" value="@Model.Email"
               autocomplete="email" inputmode="email" required autofocus />

        <p><button type="submit">Email me a link</button></p>
    </form>
}
