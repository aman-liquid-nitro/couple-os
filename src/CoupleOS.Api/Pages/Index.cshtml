@page
@model IndexModel
@{ ViewData["Title"] = "Shared"; }

<h1>shared.md</h1>
<p class="muted">
    Write anything. Press Process when you are done — nothing happens until you do.
</p>

<form method="post" hx-post="/?handler=Process" hx-target="#report" hx-swap="innerHTML"
      hx-disabled-elt="#process">
    <textarea name="Text" id="Text" placeholder="we're out of detergent and coffee&#10;dinner at Priya's parents on Saturday 8pm"></textarea>

    <p>
        <button type="submit" id="process">Process</button>
        <span class="muted htmx-indicator">thinking…</span>
    </p>
</form>

<div id="report"></div>
